# Values are plain, or in single quotes when they contain $, spaces or #.

# OpenConnect VPN
OC_SERVER=vpn.example.com
OC_USER=your_username_here
OC_PASS=your_password_here

# SOCKS5 — port and its own login/password pair
SOCKS_PORT=2085
SOCKS5_USER=socks_user
SOCKS5_PASS=socks_password

# HTTP CONNECT (no TLS) — port and its own login/password pair
HTTP_PORT=2080
HTTP_USER=http_user
HTTP_PASS=http_password

# HTTPS CONNECT (TLS) — port and its own login/password pair
HTTPS_PORT=2443
HTTPS_USER=https_user
HTTPS_PASS=https_password

# MTProto (Telegram) — port and its own secret instead of a login/password.
# Secret: hex or base64, empty = generate on the first run.
# The Fake TLS domain only applies when a new secret is generated.
MTPROTO_PORT=2444
MTPROTO_SECRET=
MTPROTO_FAKE_TLS=cloudflare.com
